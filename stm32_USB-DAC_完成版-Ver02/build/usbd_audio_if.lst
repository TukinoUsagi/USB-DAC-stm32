 196:USB_DEVICE/App/usbd_audio_if.c **** /**
 197:USB_DEVICE/App/usbd_audio_if.c ****   * @brief  AUDIO_CMD_START / PLAY / STOP
 198:USB_DEVICE/App/usbd_audio_if.c ****   *
 199:USB_DEVICE/App/usbd_audio_if.c ****   * START:
 200:USB_DEVICE/App/usbd_audio_if.c ****   *   USBバッファが十分に蓄積したとき、
 201:USB_DEVICE/App/usbd_audio_if.c ****   *   usbd_audio.cから呼ばれる。
 202:USB_DEVICE/App/usbd_audio_if.c ****   *
 203:USB_DEVICE/App/usbd_audio_if.c ****   * PLAY:
 204:USB_DEVICE/App/usbd_audio_if.c ****   *   USBD_AUDIO_Sync()からの同期通知。
 205:USB_DEVICE/App/usbd_audio_if.c ****   *   rd_ptrは変更しない。
 206:USB_DEVICE/App/usbd_audio_if.c ****   *
 207:USB_DEVICE/App/usbd_audio_if.c ****   * STOP:
 208:USB_DEVICE/App/usbd_audio_if.c ****   *   TIM4を停止し、無音を出力する。
 209:USB_DEVICE/App/usbd_audio_if.c ****   */
 210:USB_DEVICE/App/usbd_audio_if.c **** static int8_t AUDIO_IF_AudioCmd(
 211:USB_DEVICE/App/usbd_audio_if.c ****     uint8_t *pbuf,
 212:USB_DEVICE/App/usbd_audio_if.c ****     uint32_t size,
 213:USB_DEVICE/App/usbd_audio_if.c ****     uint8_t cmd)
 214:USB_DEVICE/App/usbd_audio_if.c **** {
 215:USB_DEVICE/App/usbd_audio_if.c ****   UNUSED(pbuf);
 216:USB_DEVICE/App/usbd_audio_if.c ****   UNUSED(size);
 217:USB_DEVICE/App/usbd_audio_if.c **** 
 218:USB_DEVICE/App/usbd_audio_if.c ****   USBD_AUDIO_HandleTypeDef *haudio;
 219:USB_DEVICE/App/usbd_audio_if.c **** 
 220:USB_DEVICE/App/usbd_audio_if.c ****   switch (cmd)
 221:USB_DEVICE/App/usbd_audio_if.c ****   {
 222:USB_DEVICE/App/usbd_audio_if.c ****     case AUDIO_CMD_START:
 223:USB_DEVICE/App/usbd_audio_if.c **** 
 224:USB_DEVICE/App/usbd_audio_if.c ****       /*
 225:USB_DEVICE/App/usbd_audio_if.c ****        * USB Audioミドルウェアのハンドルを取得。
 226:USB_DEVICE/App/usbd_audio_if.c ****        */
 227:USB_DEVICE/App/usbd_audio_if.c ****       haudio =
 228:USB_DEVICE/App/usbd_audio_if.c ****           USBD_AUDIO_GetHandle(
 229:USB_DEVICE/App/usbd_audio_if.c ****               &hUsbDeviceFS);
 230:USB_DEVICE/App/usbd_audio_if.c **** 
 231:USB_DEVICE/App/usbd_audio_if.c ****       if (haudio == NULL)
 232:USB_DEVICE/App/usbd_audio_if.c ****       {
 233:USB_DEVICE/App/usbd_audio_if.c ****         g_usb_audio_playing = 0U;
 234:USB_DEVICE/App/usbd_audio_if.c ****         return -1;
 235:USB_DEVICE/App/usbd_audio_if.c ****       }
 236:USB_DEVICE/App/usbd_audio_if.c **** 
 237:USB_DEVICE/App/usbd_audio_if.c ****       /*
 238:USB_DEVICE/App/usbd_audio_if.c ****        * TIM4再生位置をリングバッファ先頭にする。
 239:USB_DEVICE/App/usbd_audio_if.c ****        *
 240:USB_DEVICE/App/usbd_audio_if.c ****        * rd_ptrはTIM4側が管理する。
 241:USB_DEVICE/App/usbd_audio_if.c ****        */
 242:USB_DEVICE/App/usbd_audio_if.c ****       haudio->rd_ptr = 0U;
 243:USB_DEVICE/App/usbd_audio_if.c **** 
 244:USB_DEVICE/App/usbd_audio_if.c ****       /*
 245:USB_DEVICE/App/usbd_audio_if.c ****        * USBからバッファ半分までデータを
 246:USB_DEVICE/App/usbd_audio_if.c ****        * 受信済みなので再生可能。
 247:USB_DEVICE/App/usbd_audio_if.c ****        */
 248:USB_DEVICE/App/usbd_audio_if.c ****       haudio->rd_enable = 1U;
 249:USB_DEVICE/App/usbd_audio_if.c **** 
ARM GAS  /tmp/ccqZ1dnq.s 			page 7


 250:USB_DEVICE/App/usbd_audio_if.c ****       /*
 251:USB_DEVICE/App/usbd_audio_if.c ****        * デバッグ情報を初期化。

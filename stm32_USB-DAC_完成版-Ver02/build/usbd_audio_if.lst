 296:USB_DEVICE/App/usbd_audio_if.c ****        */
 297:USB_DEVICE/App/usbd_audio_if.c ****       break;
 298:USB_DEVICE/App/usbd_audio_if.c **** 
 299:USB_DEVICE/App/usbd_audio_if.c **** 
 300:USB_DEVICE/App/usbd_audio_if.c ****     case AUDIO_CMD_STOP:
 301:USB_DEVICE/App/usbd_audio_if.c **** 
 302:USB_DEVICE/App/usbd_audio_if.c ****       /*
 303:USB_DEVICE/App/usbd_audio_if.c ****        * USB再生停止。

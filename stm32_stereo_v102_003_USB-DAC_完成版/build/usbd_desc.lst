   1:USB_DEVICE/App/usbd_desc.c **** /**
   2:USB_DEVICE/App/usbd_desc.c ****   ******************************************************************************
   3:USB_DEVICE/App/usbd_desc.c ****   * @file    usbd_desc.c
   4:USB_DEVICE/App/usbd_desc.c ****   * @brief   USB Deviceディスクリプタ (Blue Pill Stereo BTL Class-D USB DAC)
   5:USB_DEVICE/App/usbd_desc.c ****   *
   6:USB_DEVICE/App/usbd_desc.c ****   * 注意: VID=0x0483 はSTMicroelectronicsの正式VIDです。ST公式サンプルでも
   7:USB_DEVICE/App/usbd_desc.c ****   *       自己開発ボードのデモに慣例的に使われますが、製品として販売�
   8:USB_DEVICE/App/usbd_desc.c ****   *       場合はご自身のVID/PIDを取得してください(個人の実験・趣味用途な
   9:USB_DEVICE/App/usbd_desc.c ****   *       このままで動作上は問題ありません)。
  10:USB_DEVICE/App/usbd_desc.c ****   ******************************************************************************
  11:USB_DEVICE/App/usbd_desc.c ****   */
  12:USB_DEVICE/App/usbd_desc.c **** 
  13:USB_DEVICE/App/usbd_desc.c **** #include "usbd_core.h"
  14:USB_DEVICE/App/usbd_desc.c **** #include "usbd_desc.h"
  15:USB_DEVICE/App/usbd_desc.c **** #include "usbd_conf.h"
  16:USB_DEVICE/App/usbd_desc.c **** 
  17:USB_DEVICE/App/usbd_desc.c **** #define USBD_VID                      0x0483U
  18:USB_DEVICE/App/usbd_desc.c **** #define USBD_PID                      0x5A21U   /* 趣味用の適当なPID */
  19:USB_DEVICE/App/usbd_desc.c **** #define USBD_LANGID_STRING            0x0409U   /* English (US) */
  20:USB_DEVICE/App/usbd_desc.c **** #define USBD_MANUFACTURER_STRING      "Seiji DIY Audio"
  21:USB_DEVICE/App/usbd_desc.c **** #define USBD_PRODUCT_FS_STRING        "BluePill Stereo BTL USB DAC"
  22:USB_DEVICE/App/usbd_desc.c **** #define USBD_CONFIGURATION_FS_STRING  "Audio Config"
  23:USB_DEVICE/App/usbd_desc.c **** #define USBD_INTERFACE_FS_STRING      "Audio Interface"
  24:USB_DEVICE/App/usbd_desc.c **** 
  25:USB_DEVICE/App/usbd_desc.c **** /* シリアル番号文字列ディスクリプタのバイト数
  26:USB_DEVICE/App/usbd_desc.c ****  *   bLength(1) + bDescriptorType(1) + UTF-16LE文字列(12桁の16進数字 x 2byte)
  27:USB_DEVICE/App/usbd_desc.c ****  *   = 2 + 24 = 26 = 0x1A
  28:USB_DEVICE/App/usbd_desc.c ****  *   (Get_SerialNum()が8桁+4桁=12桁をUSBD_StringSerial[2]から書き込むため)
  29:USB_DEVICE/App/usbd_desc.c ****  */
  30:USB_DEVICE/App/usbd_desc.c **** #define USB_SIZ_STRING_SERIAL         0x1AU
  31:USB_DEVICE/App/usbd_desc.c **** 
  32:USB_DEVICE/App/usbd_desc.c **** static uint8_t *USBD_Class_DeviceDescriptor(USBD_SpeedTypeDef speed, uint16_t *length);

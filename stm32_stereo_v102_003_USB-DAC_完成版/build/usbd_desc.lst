  60:USB_DEVICE/App/usbd_desc.c ****   0x00,                       /* bDeviceProtocol */
  61:USB_DEVICE/App/usbd_desc.c ****   USB_MAX_EP0_SIZE,           /* bMaxPacketSize0 */
  62:USB_DEVICE/App/usbd_desc.c ****   LOBYTE(USBD_VID), HIBYTE(USBD_VID),
  63:USB_DEVICE/App/usbd_desc.c ****   LOBYTE(USBD_PID), HIBYTE(USBD_PID),
  64:USB_DEVICE/App/usbd_desc.c ****   0x00, 0x02,                 /* bcdDevice = 2.00 */
  65:USB_DEVICE/App/usbd_desc.c ****   USBD_IDX_MFC_STR,           /* Index of manufacturer string */
  66:USB_DEVICE/App/usbd_desc.c ****   USBD_IDX_PRODUCT_STR,       /* Index of product string */
  67:USB_DEVICE/App/usbd_desc.c ****   USBD_IDX_SERIAL_STR,        /* Index of serial number string */
  68:USB_DEVICE/App/usbd_desc.c ****   USBD_MAX_NUM_CONFIGURATION  /* bNumConfigurations */
  69:USB_DEVICE/App/usbd_desc.c **** };

 136:USB_DEVICE/App/usbd_desc.c **** /* STM32の96bitユニークID(UID_BASE)からシリアル番号文字列を生成 */
 137:USB_DEVICE/App/usbd_desc.c **** static void Get_SerialNum(void)
 138:USB_DEVICE/App/usbd_desc.c **** {
 139:USB_DEVICE/App/usbd_desc.c ****   uint32_t deviceserial0 = *(uint32_t *)(UID_BASE);
 140:USB_DEVICE/App/usbd_desc.c ****   uint32_t deviceserial1 = *(uint32_t *)(UID_BASE + 0x04U);
 141:USB_DEVICE/App/usbd_desc.c ****   uint32_t deviceserial2 = *(uint32_t *)(UID_BASE + 0x08U);
 142:USB_DEVICE/App/usbd_desc.c **** 
 143:USB_DEVICE/App/usbd_desc.c ****   deviceserial0 += deviceserial2;
ARM GAS  /tmp/ccok7SDu.s 			page 5


 144:USB_DEVICE/App/usbd_desc.c **** 
 145:USB_DEVICE/App/usbd_desc.c ****   if (deviceserial0 != 0U)
 146:USB_DEVICE/App/usbd_desc.c ****   {
 147:USB_DEVICE/App/usbd_desc.c ****     IntToUnicode(deviceserial0, &USBD_StringSerial[2], 8U);

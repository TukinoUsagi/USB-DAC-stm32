  56:USB_DEVICE/App/usbd_desc.c ****   USB_DESC_TYPE_DEVICE,       /* bDescriptorType */
  57:USB_DEVICE/App/usbd_desc.c ****   0x00, 0x02,                 /* bcdUSB = 2.00 */
  58:USB_DEVICE/App/usbd_desc.c ****   0x00,                       /* bDeviceClass (Audioはインターフェース単位で宣言) */

  20:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *          ===================================================================
  21:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *                                AUDIO Class  Description
  22:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *          ===================================================================
  23:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *           This driver manages the Audio Class 1.0 following the "USB Device Class Definition fo
  24:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *           Audio Devices V1.0 Mar 18, 98".
  25:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *           This driver implements the following aspects of the specification:
  26:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - Device descriptor management
  27:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - Configuration descriptor management
  28:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - Standard AC Interface Descriptor management
  29:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - 1 Audio Streaming Interface (with single channel, PCM, Stereo mode)
  30:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - 1 Audio Streaming Endpoint
  31:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - 1 Audio Terminal Input (1 channel)
  32:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - Audio Class-Specific AC Interfaces
ARM GAS  /tmp/cc3nZ8Zz.s 			page 2


  33:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - Audio Class-Specific AS Interfaces
  34:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - AudioControl Requests: only SET_CUR and GET_CUR requests are supported (for Mute)
  35:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - Audio Feature Unit (limited to Mute control)
  36:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - Audio Synchronization type: Asynchronous
  37:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - Single fixed audio sampling rate (configurable in usbd_conf.h file)
  38:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *          The current audio class version supports the following audio features:
  39:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - Pulse Coded Modulation (PCM) format
  40:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - sampling rate: 48KHz.
  41:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - Bit resolution: 16
  42:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - Number of channels: 2
  43:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - No volume control
  44:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - Mute/Unmute capability
  45:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *             - Asynchronous Endpoints
  46:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *
  47:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   * @note     In HS mode and when the DMA is used, all variables and data structures
  48:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *           dealing with the DMA during the transaction process should be 32-bit aligned.
  49:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *
  50:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   *  @endverbatim
  51:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   ******************************************************************************
  52:Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Src/usbd_audio.c ****   */

 138:Core/Src/main.c ****   *
 139:Core/Src/main.c ****   * USBオーディオ再生中(g_usb_audio_playing==1)は、TIM1のCCRを
 140:Core/Src/main.c ****   * usbd_audio_if.c 側(TIM4割り込み)が書き込んでいるため、ここでの
 141:Core/Src/main.c ****   * 上書きをスキップして衝突を避ける。
 142:Core/Src/main.c ****   * @retval None
 143:Core/Src/main.c ****   */
 144:Core/Src/main.c **** void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef *hadc)
 145:Core/Src/main.c **** {
 146:Core/Src/main.c ****   if (hadc->Instance != ADC1)
ARM GAS  /tmp/ccvADxDw.s 			page 4


 147:Core/Src/main.c ****   {
 148:Core/Src/main.c ****     return;
 149:Core/Src/main.c ****   }
 150:Core/Src/main.c **** 
 151:Core/Src/main.c ****   if (g_usb_audio_playing)
 152:Core/Src/main.c ****   {
 153:Core/Src/main.c ****     /* USBオーディオがCCRを制御中なのでADC側は何もしない */
 154:Core/Src/main.c ****     return;
 155:Core/Src/main.c ****   }
 156:Core/Src/main.c **** 

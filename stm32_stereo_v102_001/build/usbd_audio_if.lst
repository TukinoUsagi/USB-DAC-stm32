   1:USB_DEVICE/App/usbd_audio_if.c **** /**
   2:USB_DEVICE/App/usbd_audio_if.c ****   ******************************************************************************
   3:USB_DEVICE/App/usbd_audio_if.c ****   * @file    usbd_audio_if.c
   4:USB_DEVICE/App/usbd_audio_if.c ****   * @brief   USB Audio再生エンジン本体
   5:USB_DEVICE/App/usbd_audio_if.c ****   *
   6:USB_DEVICE/App/usbd_audio_if.c ****   * ----------------------------------------------------------------------------
   7:USB_DEVICE/App/usbd_audio_if.c ****   * 動作の流れ
   8:USB_DEVICE/App/usbd_audio_if.c ****   * ----------------------------------------------------------------------------
   9:USB_DEVICE/App/usbd_audio_if.c ****   *   PC (USB Audio Class 1.0, 16bit stereo, USBD_AUDIO_FREQ Hz)
  10:USB_DEVICE/App/usbd_audio_if.c ****   *       ↓ (毎USBフレーム=1msごとにISOアウト転送)
  11:USB_DEVICE/App/usbd_audio_if.c ****   *   usbd_audio.c (ST公式ミドルウェア)
  12:USB_DEVICE/App/usbd_audio_if.c ****   *       ↓ haudio->buffer[] というリングバッファに書き込み
  13:USB_DEVICE/App/usbd_audio_if.c ****   *   AUDIO_IF_AudioCmd(AUDIO_CMD_START) で
  14:USB_DEVICE/App/usbd_audio_if.c ****   *       g_audio_ring = &haudio->buffer[0] を受け取り保持
  15:USB_DEVICE/App/usbd_audio_if.c ****   *       ↓
  16:USB_DEVICE/App/usbd_audio_if.c ****   *   TIM4 割り込み (USBD_AUDIO_FREQ Hzごとに発火)
  17:USB_DEVICE/App/usbd_audio_if.c ****   *       g_audio_ring[g_play_ptr] から1サンプル(L16+R16=4byte)取り出し
  18:USB_DEVICE/App/usbd_audio_if.c ****   *       ↓ 0..65535 にオフセットしてPWM CCR範囲にスケーリング
  19:USB_DEVICE/App/usbd_audio_if.c ****   *   TIM1 CCR1(LEFT) / CCR2(RIGHT) 書き込み
  20:USB_DEVICE/App/usbd_audio_if.c ****   *       ↓
  21:USB_DEVICE/App/usbd_audio_if.c ****   *   TIM1 120kHz相補PWM出力 (PA8/PB13, PA9/PB14)
  22:USB_DEVICE/App/usbd_audio_if.c ****   *
  23:USB_DEVICE/App/usbd_audio_if.c ****   * リングバッファの読み出し位置(g_play_ptr)は書き込み側(wr_ptr)と
  24:USB_DEVICE/App/usbd_audio_if.c ****   * 完全に独立したフリーランタイマーで進む。半周・1周進むごとに
  25:USB_DEVICE/App/usbd_audio_if.c ****   * USBD_AUDIO_Sync() を呼び、ホストとの速度差(クロックドリフト)を
  26:USB_DEVICE/App/usbd_audio_if.c ****   * ライブラリ内蔵の±4byte補正ロジックに反映させる。
  27:USB_DEVICE/App/usbd_audio_if.c ****   * ----------------------------------------------------------------------------
  28:USB_DEVICE/App/usbd_audio_if.c ****   */
  29:USB_DEVICE/App/usbd_audio_if.c **** 
  30:USB_DEVICE/App/usbd_audio_if.c **** #include "usbd_audio_if.h"
  31:USB_DEVICE/App/usbd_audio_if.c **** #include "main.h"
  32:USB_DEVICE/App/usbd_audio_if.c **** 
  33:USB_DEVICE/App/usbd_audio_if.c **** 
ARM GAS  /tmp/ccI6ORsy.s 			page 2



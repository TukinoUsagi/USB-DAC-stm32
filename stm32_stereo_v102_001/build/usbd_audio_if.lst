  98:USB_DEVICE/App/usbd_audio_if.c **** /**
  99:USB_DEVICE/App/usbd_audio_if.c ****   * @brief  AUDIO_CMD_START / PLAY / STOP を処理する
 100:USB_DEVICE/App/usbd_audio_if.c ****   *
 101:USB_DEVICE/App/usbd_audio_if.c ****   *   START: ホストからの最初の1周分データが揃った合図。
 102:USB_DEVICE/App/usbd_audio_if.c ****   *          リングバッファの先頭アドレスを保存し、TIM4割り込みを起動す�
 103:USB_DEVICE/App/usbd_audio_if.c ****   *   PLAY : Sync()がAUDIO_OFFSET_FULLで呼ばれた際の再同期チェックポイント。
 104:USB_DEVICE/App/usbd_audio_if.c ****   *          このアーキテクチャでは特に処理不要(no-op)。
 105:USB_DEVICE/App/usbd_audio_if.c ****   *   STOP : ホストが再生を止めた。TIM4を止め、無音を出力する。
 106:USB_DEVICE/App/usbd_audio_if.c ****   */
 107:USB_DEVICE/App/usbd_audio_if.c **** static int8_t AUDIO_IF_AudioCmd(uint8_t *pbuf, uint32_t size, uint8_t cmd)
ARM GAS  /tmp/ccI6ORsy.s 			page 5


 108:USB_DEVICE/App/usbd_audio_if.c **** {
 109:USB_DEVICE/App/usbd_audio_if.c ****   UNUSED(size);
 110:USB_DEVICE/App/usbd_audio_if.c **** 
 111:USB_DEVICE/App/usbd_audio_if.c ****   switch (cmd)
 112:USB_DEVICE/App/usbd_audio_if.c ****   {
 113:USB_DEVICE/App/usbd_audio_if.c ****     case AUDIO_CMD_START:
 114:USB_DEVICE/App/usbd_audio_if.c ****       g_audio_ring       = pbuf;   /* &haudio->buffer[0] */
 115:USB_DEVICE/App/usbd_audio_if.c ****       g_play_ptr         = 0U;
 116:USB_DEVICE/App/usbd_audio_if.c ****       g_bytes_since_sync = 0U;
 117:USB_DEVICE/App/usbd_audio_if.c ****       g_sync_half_toggle = 0U;
 118:USB_DEVICE/App/usbd_audio_if.c ****       g_usb_audio_playing = 1U;
 119:USB_DEVICE/App/usbd_audio_if.c ****       HAL_TIM_Base_Start_IT(&htim4);
 120:USB_DEVICE/App/usbd_audio_if.c ****       break;
 121:USB_DEVICE/App/usbd_audio_if.c **** 
 122:USB_DEVICE/App/usbd_audio_if.c ****     case AUDIO_CMD_PLAY:
 123:USB_DEVICE/App/usbd_audio_if.c ****       /* 再同期チェックポイント。g_play_ptrは常に自走しているのでno-op */
 124:USB_DEVICE/App/usbd_audio_if.c ****       break;
 125:USB_DEVICE/App/usbd_audio_if.c **** 
 126:USB_DEVICE/App/usbd_audio_if.c ****     case AUDIO_CMD_STOP:
 127:USB_DEVICE/App/usbd_audio_if.c ****       g_usb_audio_playing = 0U;
 128:USB_DEVICE/App/usbd_audio_if.c ****       HAL_TIM_Base_Stop_IT(&htim4);
 129:USB_DEVICE/App/usbd_audio_if.c ****       AUDIO_OutputSilence();
 130:USB_DEVICE/App/usbd_audio_if.c ****       break;
 131:USB_DEVICE/App/usbd_audio_if.c **** 
 132:USB_DEVICE/App/usbd_audio_if.c ****     default:
 133:USB_DEVICE/App/usbd_audio_if.c ****       break;
 134:USB_DEVICE/App/usbd_audio_if.c ****   }
 135:USB_DEVICE/App/usbd_audio_if.c **** 
 136:USB_DEVICE/App/usbd_audio_if.c ****   return 0;
 137:USB_DEVICE/App/usbd_audio_if.c **** }
